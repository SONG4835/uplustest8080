          "children": [
            { "name": "Tag", "variant": {}, "props": { "Label": "추천", "showWhen": "plan.recommended" }, "children": [] },
            {
              "name": "Card/Price",
              "variant": {},
              "props": {
                "Label": "매달 내는 금액",
                "Value": "{plan.monthly_price}원",
                "Desc": "{discount_months}개월 할인 후: {months+1}개월째부터 {plan.price_after_discount}원 (p03만)"
              },
              "children": []
            },
            {
              "name": "div",
              "variant": {},
              "props": { "role": "basic-items" },
              "children": [
                { "name": "List/Row", "variant": { "Type": "default" }, "props": { "Label": "데이터", "Value": "{plan.data}" }, "children": [] },
